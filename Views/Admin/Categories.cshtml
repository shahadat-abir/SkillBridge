@model List<JobCategory>
@{ ViewData["Title"] = "Categories & skills"; var skills = (List<Skill>)ViewBag.Skills; }
<h1 class="h3 mb-3">Categories &amp; skills</h1>
<partial name="_Nav" />
<div class="row g-4">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">Job categories</div>
            <div class="card-body">
                <form asp-action="AddCategory" method="post" class="row g-2 mb-3">
                    <div class="col-5"><input name="name" class="form-control form-control-sm" placeholder="Name" required maxlength="80" aria-label="Category name" /></div>
                    <div class="col-5"><input name="description" class="form-control form-control-sm" placeholder="Description" maxlength="300" aria-label="Category description" /></div>
                    <div class="col-2"><button class="btn btn-sm btn-primary w-100">Add</button></div>
                </form>
                <ul class="list-group">
                    @foreach (var c in Model)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>@c.Name <span class="small text-muted">@c.Description</span></span>
                            <form asp-action="ToggleCategory" asp-route-id="@c.Id" method="post">
                                <button class="btn btn-sm @(c.IsActive ? "btn-outline-secondary" : "btn-outline-success")">@(c.IsActive ? "Disable" : "Enable")</button>
                            </form>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">Skills catalogue</div>
            <div class="card-body">
                <form asp-action="AddSkill" method="post" class="row g-2 mb-3">
                    <div class="col-5"><input name="name" class="form-control form-control-sm" placeholder="Skill" required maxlength="60" aria-label="Skill name" /></div>
                    <div class="col-5"><input name="category" class="form-control form-control-sm" placeholder="Group (optional)" maxlength="60" aria-label="Skill group" /></div>
                    <div class="col-2"><button class="btn btn-sm btn-primary w-100">Add</button></div>
                </form>
                <ul class="list-group">
                    @foreach (var s in skills)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>@s.Name <span class="small text-muted">@s.Category</span> @if (!s.IsActive) { <span class="badge text-bg-secondary">disabled</span> }</span>
                            <form asp-action="ToggleSkill" asp-route-id="@s.Id" method="post">
                                <button class="btn btn-sm @(s.IsActive ? "btn-outline-secondary" : "btn-outline-success")">@(s.IsActive ? "Disable" : "Enable")</button>
                            </form>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>
