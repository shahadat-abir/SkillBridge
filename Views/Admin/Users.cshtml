@model PagedResult<AdminUserRow>
@{ ViewData["Title"] = "Users"; }
<h1 class="h3 mb-3">Users</h1>
<partial name="_Nav" />
<form method="get" class="d-flex gap-2 mb-3" role="search">
    <input name="q" value="@ViewBag.Query" class="form-control" placeholder="Search name or email" aria-label="Search users" />
    <button class="btn btn-outline-primary">Search</button>
</form>
<div class="card"><div class="table-responsive">
    <table class="table align-middle mb-0 small">
        <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Joined</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
        <tbody>
        @foreach (var u in Model.Items)
        {
            <tr>
                <td><a asp-controller="Profile" asp-action="Details" asp-route-id="@u.Id">@u.FullName</a> @if (u.IsDemo) { <span class="badge text-bg-secondary">demo</span> }</td>
                <td class="text-break">@u.Email</td>
                <td>@u.Role</td>
                <td>@u.CreatedAt.Local("dd MMM yyyy")</td>
                <td>@if (u.IsSuspended) { <span class="badge text-bg-danger">Suspended</span> } else { <span class="badge text-bg-success">Active</span> }</td>
                <td class="text-end">
                    <div class="d-inline-flex flex-wrap gap-1 justify-content-end">
                        <form asp-action="ChangeRole" method="post" class="d-flex gap-1">
                            <input type="hidden" name="id" value="@u.Id" />
                            <select name="role" class="form-select form-select-sm w-auto" aria-label="Role for @u.FullName">
                                @foreach (var r in AppRoles.All)
                                {
                                    <!option value="@r" selected="@(u.Role == r)">@r</!option>
                                }
                            </select>
                            <button class="btn btn-sm btn-outline-secondary">Set role</button>
                        </form>
                        @if (u.IsSuspended)
                        {
                            <form asp-action="Reactivate" method="post"><input type="hidden" name="id" value="@u.Id" /><button class="btn btn-sm btn-outline-success">Reactivate</button></form>
                        }
                        else
                        {
                            <form asp-action="Suspend" method="post" class="d-flex gap-1" data-confirm="Suspend @u.FullName? They will be signed out and unable to log in.">
                                <input type="hidden" name="id" value="@u.Id" />
                                <input name="reason" class="form-control form-control-sm" placeholder="Reason" maxlength="500" />
                                <button class="btn btn-sm btn-outline-danger">Suspend</button>
                            </form>
                        }
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div></div>
<div class="mt-3"><partial name="_Pager" model="@(new PagerModel { Page = Model.Page, TotalPages = Model.TotalPages, Action = "Users", Controller = "Admin", RouteValues = new Dictionary<string, string?> { ["q"] = (string?)ViewBag.Query } })" /></div>
