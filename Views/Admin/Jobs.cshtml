@model PagedResult<JobListItemViewModel>
@{ ViewData["Title"] = "All jobs"; }
<h1 class="h3 mb-3">All jobs</h1>
<partial name="_Nav" />
<div class="card"><div class="table-responsive">
    <table class="table align-middle mb-0 small">
        <thead><tr><th>Job</th><th>Employer</th><th>Mode</th><th>Budget</th><th>Created</th><th>Status</th><th></th></tr></thead>
        <tbody>
        @foreach (var j in Model.Items)
        {
            <tr>
                <td><a asp-controller="Jobs" asp-action="Details" asp-route-id="@j.Id">@j.Title</a> @if (j.IsDemoData) { <span class="badge text-bg-secondary">demo</span> }</td>
                <td>@j.EmployerName</td>
                <td>@j.Mode</td>
                <td>@UiHelpers.Money(j.Budget, j.Currency)</td>
                <td>@j.CreatedAt.Local("dd MMM yyyy")</td>
                <td><span class="badge @UiHelpers.Badge(j.Status)">@j.Status.DisplayName()</span></td>
                <td class="text-end">
                    @if (j.Status is not (JobStatus.Completed or JobStatus.Cancelled))
                    {
                        <form asp-controller="Jobs" asp-action="Cancel" asp-route-id="@j.Id" method="post" class="d-flex gap-1 justify-content-end" data-confirm="Cancel this job as administrator?">
                            <input name="reason" class="form-control form-control-sm w-auto" placeholder="Reason" maxlength="300" />
                            <button class="btn btn-sm btn-outline-danger">Cancel</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div></div>
<div class="mt-3"><partial name="_Pager" model="@(new PagerModel { Page = Model.Page, TotalPages = Model.TotalPages, Action = "Jobs", Controller = "Admin" })" /></div>
