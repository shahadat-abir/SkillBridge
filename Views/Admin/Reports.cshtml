@model List<ContentReport>
@{ ViewData["Title"] = "Reports"; }
<h1 class="h3 mb-3">Reported content</h1>
<partial name="_Nav" />
@if (Model.Count == 0)
{
    <div class="card"><div class="card-body text-muted text-center py-5">No reports.</div></div>
}
@foreach (var r in Model)
{
    <div class="card mb-3"><div class="card-body">
        <div class="d-flex justify-content-between flex-wrap gap-2">
            <div><a asp-controller="Jobs" asp-action="Details" asp-route-id="@r.JobId" class="fw-semibold">@r.Job.Title</a>
                <div class="small text-muted">reported by @r.Reporter.FullName · @r.CreatedAt.Local()</div></div>
            <span class="badge @(r.Status == ReportStatus.Open ? "text-bg-danger" : "text-bg-secondary")">@r.Status</span>
        </div>
        <p class="pre-wrap mt-2 mb-2">@r.Reason</p>
        @if (r.AdminNote != null) { <p class="small"><strong>Admin note:</strong> @r.AdminNote</p> }
        @if (r.Status == ReportStatus.Open)
        {
            <form asp-action="ResolveReport" asp-route-id="@r.Id" method="post" class="row g-2 align-items-center">
                <div class="col-md-5"><input name="note" class="form-control form-control-sm" placeholder="Note" maxlength="1000" aria-label="Admin note" /></div>
                <div class="col-md-3">
                    <select name="status" class="form-select form-select-sm" aria-label="Decision">
                        <option value="Resolved">Resolved</option>
                        <option value="Dismissed">Dismissed</option>
                    </select>
                </div>
                <div class="col-md-2 form-check"><input class="form-check-input" type="checkbox" name="cancelJob" value="true" id="cj-@r.Id" /><label class="form-check-label small" for="cj-@r.Id">Cancel job</label></div>
                <div class="col-md-2"><button class="btn btn-sm btn-primary w-100">Save</button></div>
            </form>
        }
    </div></div>
}
