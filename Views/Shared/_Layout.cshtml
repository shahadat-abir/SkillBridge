@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole(AppRoles.Admin);
    var isEmployer = User.IsInRole(AppRoles.Employer);
    var isHunter = User.IsInRole(AppRoles.Hunter);
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string c) => string.Equals(controller, c, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · SkillBridge</title>
    <meta name="description" content="SkillBridge — Connect Skills. Discover Opportunities. Deliver Results." />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <a class="visually-hidden-focusable p-2" href="#main">Skip to content</a>
    <nav class="navbar navbar-expand-lg navbar-dark sb-navbar shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                <span class="sb-logo"><i class="bi bi-bridge"></i></span> SkillBridge
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link @Active("Jobs")" asp-controller="Jobs" asp-action="Index">Browse jobs</a></li>
                    @if (signedIn)
                    {
                        <li class="nav-item"><a class="nav-link @Active("Dashboard")" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                    }
                    @if (isEmployer)
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Jobs" asp-action="Mine">My jobs</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Assignments")" asp-controller="Assignments" asp-action="Index">Assignments</a></li>
                    }
                    @if (isHunter)
                    {
                        <li class="nav-item"><a class="nav-link @Active("Applications")" asp-controller="Applications" asp-action="Mine">My applications</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Assignments")" asp-controller="Assignments" asp-action="Index">My work</a></li>
                    }
                    @if (signedIn)
                    {
                        <li class="nav-item"><a class="nav-link @Active("Payments")" asp-controller="Payments" asp-action="Index">Payments</a></li>
                    }
                    @if (isAdmin)
                    {
                        <li class="nav-item"><a class="nav-link @Active("Admin")" asp-controller="Admin" asp-action="Index"><i class="bi bi-shield-lock"></i> Admin</a></li>
                    }
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="About">About</a></li>
                </ul>
                <ul class="navbar-nav align-items-lg-center">
                    @if (signedIn)
                    {
                        <li class="nav-item">@await Component.InvokeAsync("NotificationBell")</li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle"></i> @User.Identity!.Name
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" asp-controller="Profile" asp-action="Me">My profile</a></li>
                                <li><a class="dropdown-item" asp-controller="Profile" asp-action="Edit">Edit profile</a></li>
                                @if (isHunter)
                                {
                                    <li><a class="dropdown-item" asp-controller="Profile" asp-action="Skills">My skills</a></li>
                                }
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="px-3">
                                        <button type="submit" class="btn btn-link p-0 text-danger text-decoration-none">Sign out</button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Sign in</a></li>
                        <li class="nav-item"><a class="btn btn-warning btn-sm ms-lg-2 fw-semibold" asp-controller="Account" asp-action="Register">Join SkillBridge</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main id="main" class="container py-4 flex-grow-1">
        @if (TempData["Success"] is string ok)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert"><i class="bi bi-check-circle"></i> @ok<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>
        }
        @if (TempData["Error"] is string err)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert"><i class="bi bi-exclamation-triangle"></i> @err<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>
        }
        @RenderBody()
    </main>

    <footer class="sb-footer py-4 mt-4 small">
        <div class="container d-flex flex-column flex-md-row justify-content-between gap-2">
            <div><strong>SkillBridge</strong> — Connect Skills. Discover Opportunities. Deliver Results.</div>
            <div>CSE 3234 (V4) Software Engineering Laboratory · Dept. of CSE, Premier University, Chittagong · &copy; @DateTime.Now.Year</div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
