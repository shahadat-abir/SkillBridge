@model ErrorViewModel
@{ ViewData["Title"] = "Error"; }
<div class="text-center py-5">
    <h1 class="display-6 text-danger"><i class="bi bi-exclamation-octagon"></i> Something went wrong</h1>
    <p class="text-muted">The error has been logged. Please try again or go back to the home page.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small">Request ID: <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Home</a>
</div>
