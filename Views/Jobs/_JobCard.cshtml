@model JobListItemViewModel
<div class="card sb-job-card h-100">
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start mb-1 gap-2">
            <span class="badge sb-difficulty" title="Job difficulty (complexity of the work)">@Model.Difficulty.StarsText() @Model.Difficulty.DisplayName()</span>
            <span class="badge @UiHelpers.Badge(Model.Status)">@Model.Status.DisplayName()</span>
        </div>
        <h3 class="h6 mt-2 mb-1"><a asp-controller="Jobs" asp-action="Details" asp-route-id="@Model.Id" class="stretched-link text-decoration-none">@Model.Title</a></h3>
        <div class="small text-muted mb-2">@Model.CategoryName · @Model.EmployerName</div>
        <p class="small mb-2 flex-grow-1">@Model.Summary</p>
        <div class="mb-2">
            @foreach (var s in Model.Skills.Take(4)) { <span class="badge text-bg-light border me-1">@s</span> }
        </div>
        <div class="d-flex justify-content-between small">
            <span class="fw-semibold">@UiHelpers.Money(Model.Budget, Model.Currency)</span>
            @if (Model.Mode == JobMode.Challenge)
            {
                <span class="text-warning-emphasis"><i class="bi bi-trophy"></i> Challenge @Model.ApplicationsCount/@Model.MaxParticipants</span>
            }
            else
            {
                <span class="text-muted">@Model.ApplicationsCount applicant(s)</span>
            }
        </div>
        <div class="small text-muted mt-1"><i class="bi bi-clock"></i> Apply by @Model.ApplicationDeadline.Local("dd MMM yyyy")</div>
    </div>
</div>
