@model PagedResult<Notification>
@{ ViewData["Title"] = "Notifications"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Notifications</h1>
    @if (Model.Items.Any(n => !n.IsRead))
    {
        <form asp-action="MarkAllRead" method="post"><button class="btn btn-sm btn-outline-secondary">Mark all as read</button></form>
    }
</div>
<p class="small text-muted">In-app notifications only (no email or SMS is sent).</p>
@if (Model.TotalCount == 0)
{
    <div class="card"><div class="card-body text-center text-muted py-5"><i class="bi bi-bell-slash fs-1 d-block mb-2"></i>No notifications yet.</div></div>
}
else
{
    <div class="list-group mb-3">
        @foreach (var n in Model.Items)
        {
            <form asp-action="Open" asp-route-id="@n.Id" method="post" class="list-group-item list-group-item-action @(n.IsRead ? "" : "list-group-item-primary")">
                <button type="submit" class="btn btn-link text-start text-decoration-none text-body p-0 w-100">
                    <div class="d-flex justify-content-between gap-2">
                        <strong>@if (!n.IsRead) { <span class="badge text-bg-primary me-1">New</span> }@n.Title</strong>
                        <span class="small text-muted text-nowrap">@n.CreatedAt.Local("dd MMM, h:mm tt")</span>
                    </div>
                    <div class="small">@n.Message</div>
                </button>
            </form>
        }
    </div>
    <partial name="_Pager" model="@(new PagerModel { Page = Model.Page, TotalPages = Model.TotalPages, Action = "Index", Controller = "Notifications" })" />
}
