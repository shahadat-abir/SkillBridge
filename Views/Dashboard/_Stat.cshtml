@model (string Label, string Value, string Icon)
<div class="card h-100"><div class="card-body">
    <div class="d-flex justify-content-between align-items-start">
        <div><div class="sb-stat">@Model.Value</div><div class="sb-stat-label">@Model.Label</div></div>
        <i class="bi @Model.Icon fs-3 text-sb opacity-50"></i>
    </div>
</div></div>
