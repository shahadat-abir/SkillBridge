@model RegisterViewModel
@{ ViewData["Title"] = "Join SkillBridge"; }
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card"><div class="card-body p-4">
            <h1 class="h3 mb-1">Create your account</h1>
            <p class="text-muted">Choose how you want to use SkillBridge.</p>
            <form asp-action="Register" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <fieldset class="mb-3">
                    <legend class="form-label fs-6">I want to join as</legend>
                    <div class="row g-2">
                        <div class="col-6">
                            <input type="radio" class="btn-check" asp-for="Role" value="Hunter" id="role-hunter" />
                            <label class="btn btn-outline-primary w-100 py-3" for="role-hunter"><i class="bi bi-person-badge d-block fs-3"></i>Hunter<br /><small>I want to find work</small></label>
                        </div>
                        <div class="col-6">
                            <input type="radio" class="btn-check" asp-for="Role" value="Employer" id="role-employer" />
                            <label class="btn btn-outline-primary w-100 py-3" for="role-employer"><i class="bi bi-briefcase d-block fs-3"></i>Employer<br /><small>I want to hire</small></label>
                        </div>
                    </div>
                    <span asp-validation-for="Role" class="text-danger small"></span>
                </fieldset>
                <div class="mb-3">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" autocomplete="name" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
                <div class="mb-3" id="company-group">
                    <label asp-for="CompanyName" class="form-label"></label>
                    <input asp-for="CompanyName" class="form-control" autocomplete="organization" />
                </div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>
                <p class="small text-muted">At least 8 characters with an upper-case letter, a lower-case letter and a digit.</p>
                <button type="submit" class="btn btn-primary w-100">Create account</button>
            </form>
            <p class="mt-3 mb-0 text-center small">Already registered? <a asp-action="Login">Sign in</a></p>
        </div></div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
